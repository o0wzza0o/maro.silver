{
  "mcpServers": {
    "devin/supabase-mcp-server": {
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "command": "npx",
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN_HERE"
      },
      "registry": "devin/supabase-mcp-server"
    },
    "maro server": {
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "command": "npx",
      "env": {
        "SUPABASE_ACCESS_TOKEN": "YOUR_SUPABASE_ACCESS_TOKEN_HERE"
      },
      "registry": "devin/supabase-mcp-server"
    }
  }
}
